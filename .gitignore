# Python
__pycache__/
*.pyc
.venv/
.env
**/.env

# Data directory (large files)
data/images_*/
data/*.zip
data/*.tar.gz

# Keep data CSV and PDF files
!data/*.csv
!data/*.pdf

# Model checkpoints
models/*.pth
!models/README.md

# Results and outputs
results/*
!results/README.md
!results/*.png
visualizations/
logs/
*.data

# System files
.DS_Store
*.swp
*.swo

# IDE
.vscode/
.idea/
*.code-workspace

# Jupyter notebooks checkpoints
.ipynb_checkpoints/

# ONNX models (large)
*.onnx

# Azure resource dumps / sensitive infrastructure files
all_resources.json
infra/params.json
infra/secrets.bicep

# Frontend build artifacts
frontend/dist/
frontend/node_modules/
frontend/build_error.txt
frontend/.env.production

# Duplicate files
backend/dockerignore
