# PulmoLens Frontend - Environment Configuration
# Copy this file to .env and fill in your actual credentials.

# --- API Configuration ---
# The base URL of your FastAPI backend.
# In local development, this is usually http://localhost:8000
# In production, this is your Azure Container App URL.
VITE_API_BASE_URL=http://localhost:8000

# --- Feature Flags ---
# Enable/Disable demo mode (mock predictions)
VITE_DEMO_MODE=false

# --- Azure Application Insights ---
# Connection string for frontend telemetry (page views, performance, errors).
# Leave blank in local development to disable telemetry.
VITE_APPINSIGHTS_CONNECTION_STRING=
